<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 系统参数：飞书API配置 -->
    <record id="lark_api_base_url" model="ir.config_parameter">
        <field name="key">lark.api.base_url</field>
        <field name="value">https://open.feishu.cn/open-apis</field>
