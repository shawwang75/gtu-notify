<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 飞书应用配置：动作 -->
    <record id="action_lark_app_config" model="ir.actions.act_window">
        <field name="name">飞书应用配置</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="env.company.id"/>
        <field name="target">current</field>
    </record>
    
    <!-- 员工绑定：动作 -->
    <record id="action_lark_employee_binding" model="ir.actions.act_window">
        <field name="name">员工绑定</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_has_lark': 1}</field>
        <field name="domain">[('lark_open_id', '!=', False)]</field>
    </record>
    
    <!-- 员工搜索视图 -->
    <record id="view_employee_lark_search" model="ir.ui.view">
        <field name="name">hr.employee.lark.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <filter string="已绑定飞书" name="has_lark"
                        domain="[('lark_open_id', '!=', False)]"/>
                <filter string="未绑定飞书" name="no_lark"
                        domain="[('lark_open_id', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
